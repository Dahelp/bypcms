Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Every portfolio case has a clean permanent URL while its content is loaded
  # from MySQL by the shared portfolio application.
  RewriteRule ^portfolio/([^/]+)/?$ portfolio/index.html?project=$1 [L,QSA]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?bypcms\.ru$ [NC]
  RewriteRule ^demo(?:/.*)?$ https://demo.bypcms.ru/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^demo\.bypcms\.ru$ [NC]
  RewriteRule ^$ demo/ [R=302,L]
  RewriteRule ^api/?$ api/index.php [L,QSA]
  RewriteRule ^install/?$ install/index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)|phpunit|README|\.sql$)">
  Require all denied
</FilesMatch>
