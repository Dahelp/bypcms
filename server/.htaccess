Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^concepts/([a-z0-9-]+)/?$ concepts/index.html?slug=$1 [L,QSA]
  RewriteRule ^(nuovi-spazi-proposal|ballettschule-salzburg-konzept|ballet-salzburg-proposal)/?$ concepts/index.html?slug=$1 [L,QSA]
  RewriteRule ^(nuovi-spazi-proposal|ballettschule-salzburg-konzept|ballet-salzburg-proposal)/index\.html$ concepts/index.html?slug=$1 [L,QSA]
  # Every portfolio case has a clean permanent URL while its content is loaded
  # from MySQL by the shared portfolio application.
  RewriteRule ^portfolio/([^/]+)/?$ portfolio/index.html?project=$1 [L,QSA]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?bypcms\.ru$ [NC]
  RewriteRule ^demo(?:/.*)?$ https://demo.bypcms.ru/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^demo\.bypcms\.ru$ [NC]
  RewriteRule ^$ demo/ [R=302,L]
  RewriteRule ^api/?$ api/index.php [L,QSA]
  RewriteRule ^install/?$ install/index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(concepts|nuovi-spazi-proposal|ballettschule-salzburg-konzept|ballet-salzburg-proposal)(/|$)" concept_private=1
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=concept_private
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Referrer-Policy "no-referrer" env=concept_private
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)|phpunit|README|\.sql$)">
  Require all denied
</FilesMatch>
